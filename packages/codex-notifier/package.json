{
  "name": "@seonggukchoi/codex-notifier",
  "version": "0.0.0",
  "description": "Codex CLI terminal notification plugin for macOS using terminal-notifier and Telegram",
  "author": "seonggukchoi",
  "license": "MIT",
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seonggukchoi/packages.js",
    "directory": "packages/codex-notifier"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "plugin",
    "notification",
    "terminal-notifier",
    "macos",
    "telegram"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".codex-plugin",
    ".agents",
    "hooks"
  ],
  "scripts": {
    "build": "rimraf dist .tsbuildinfo && tsc -p tsconfig.build.json",
    "lint": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.check.json --noEmit",
    "version": "node scripts/sync-plugin-version.mjs && git add .codex-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
