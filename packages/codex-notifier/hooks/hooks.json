{
  "description": "Desktop and Telegram notifications for Codex session, permission, subagent and MCP tool events.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js sessionStarted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js sessionCompleted",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js sessionInterrupted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js sessionCompacted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js permissionRequested",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js subagentStarted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js subagentCompleted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input|request_user_input_async",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js decisionNeeded",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js toolExecuting",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/dist/main.js toolCompleted",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
