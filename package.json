{
  "name": "packages.js",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/seonggukchoi/packages.js",
  "author": "seonggukchoi",
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "prepare": "husky",
    "upgrade": "ncu && pnpm install",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:typecheck": "nx run-many --target=test:typecheck --all",
    "test:coverage": "nx run-many --target=test:coverage --all",
    "lint": "nx run-many --target=lint --all"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.1",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@nx/nx-darwin-arm64": "^23.1.1",
    "@nx/nx-linux-x64-gnu": "^23.1.1"
  }
}
